@baseUrl = http://localhost:5157

### 200 OK - list products
GET {{baseUrl}}/api/products
Accept: application/json

### 200 OK - get product 42
GET {{baseUrl}}/api/products/42
Accept: application/json

### 404 Not Found
GET {{baseUrl}}/api/products/999
Accept: application/json

### 201 Created
POST {{baseUrl}}/api/products
Content-Type: application/json
Accept: application/json

{
  "name": "Nova USB-C Hub",
  "price": 79.99,
  "description": "A compact USB-C hub for a clean desk setup.",
  "category": "Accessories"
}

### 400 Bad Request
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "",
  "price": 0
}

### 204 No Content - delete a created product (replace 45 if needed)
DELETE {{baseUrl}}/api/products/45

###############################################################################
# Authentication vs Authorization demo
# Demo-only credentials/tokens. Do not copy this authentication design to production.
###############################################################################

### 401 Unauthorized - protected endpoint, no credentials
GET {{baseUrl}}/api/orders
Accept: application/json

### Login as customer -> 200 OK + opaque demo bearer token
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "customer",
  "password": "demo123"
}

### 200 OK - authenticated customer
GET {{baseUrl}}/api/orders
Accept: application/json
Authorization: Bearer gadget-customer-token

### 403 Forbidden - authenticated, but Customer role does not meet AdminOnly policy
GET {{baseUrl}}/api/admin/inventory
Accept: application/json
Authorization: Bearer gadget-customer-token

### Login as admin -> 200 OK + admin demo bearer token
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "admin",
  "password": "admin123"
}

### 200 OK - authenticated Admin satisfies AdminOnly policy
GET {{baseUrl}}/api/admin/inventory
Accept: application/json
Authorization: Bearer gadget-admin-token

### 401 Unauthorized - invalid bearer token
GET {{baseUrl}}/api/orders
Accept: application/json
Authorization: Bearer not-a-valid-token
